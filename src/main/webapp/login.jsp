<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · EchoVault</title><link rel="stylesheet" href="assets/css/style.css"></head><body><%@ include file="partials/nav.jspf" %><main class="auth-shell"><section class="glass auth-card"><span class="eyebrow">◈ Welcome back</span><h1>Return to your memories.</h1><p class="muted">Your future is waiting for the things you saved.</p><%@ include file="partials/flash.jspf" %><form method="post" action="login"><div class="field"><label>EMAIL ADDRESS</label><input type="email" name="email" required placeholder="you@example.com"></div><div class="field"><label>PASSWORD</label><input type="password" name="password" required placeholder="Your password"></div><button class="full">Enter my vault ↗</button></form><p class="muted" style="text-align:center;font-size:13px">New here? <a href="register.jsp" style="color:#c6b8ff">Create an account</a></p></section></main></body></html>