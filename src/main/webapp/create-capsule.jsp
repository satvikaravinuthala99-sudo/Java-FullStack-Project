<%@ page contentType="text/html;charset=UTF-8" %><% if(session.getAttribute("userId")==null){response.sendRedirect("login.jsp");return;} %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create capsule · EchoVault</title><link rel="stylesheet" href="assets/css/style.css"></head><body><%@ include file="partials/nav.jspf" %><main class="auth-shell"><section class="glass auth-card" style="width:min(100%,700px)"><span class="eyebrow">✧ Seal a moment in time</span><h1>Create your capsule.</h1><p class="muted">Choose what to preserve—and when the future can see it.</p><%@ include file="partials/flash.jspf" %><form method="post" action="create-capsule" enctype="multipart/form-data"><div class="form-grid"><div class="field span2"><label>CAPSULE TITLE</label><input name="title" maxlength="150" required placeholder="A letter to my 2030 self"></div><div class="field span2"><label>YOUR MESSAGE / DESCRIPTION</label><textarea name="description" maxlength="5000" placeholder="Write the story you want your future self to remember..."></textarea></div><div class="field"><label>UNLOCK DATE & TIME</label><input type="datetime-local" name="unlockAt" required></div><div class="field"><label>WHO CAN ACCESS?</label><select name="visibility" id="visibility"><option value="PRIVATE">Only me · Private</option><option value="SHARED">A recipient · Shared</option></select></div><div class="field span2" id="recipientField" style="display:none"><label>RECIPIENT EMAIL</label><input type="email" name="recipientEmail" placeholder="someone@example.com"></div><div class="field span2"><label>ATTACH A MEMORY · OPTIONAL (MAX 10 MB)</label><input type="file" name="memoryFile" accept="image/*,audio/*,video/*,.pdf"></div></div><button class="full">◈ Seal this capsule</button><p class="muted" style="font-size:11px;line-height:1.6">Your capsule is private by default. Access is checked by the server, and attachments are stored outside the public web folder. Do not upload sensitive identity or financial documents.</p></form></section></main><script>const v=document.getElementById('visibility'),f=document.getElementById('recipientField');v.addEventListener('change',()=>f.style.display=v.value==='SHARED'?'block':'none');const d=document.querySelector('[name=unlockAt]');const now=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,16);d.min=now;</script></body></html>