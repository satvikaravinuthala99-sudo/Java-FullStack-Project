<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.echovault.model.Capsule,com.echovault.util.Html" %><%if(session.getAttribute("adminId")==null){response.sendRedirect("admin-login.jsp");return;}List<Capsule> list=(List<Capsule>)request.getAttribute("capsules");%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Control room · EchoVault</title><link rel="stylesheet" href="assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="index.jsp">◈ echo<b>vault</b> / ADMIN</a><div class="navlinks"><a href="admin-logout">Sign out</a></div></nav><main class="wrap"><span class="eyebrow">SYSTEM OVERVIEW</span><h1 style="font:600 42px 'Space Grotesk'">The control room.</h1><p class="muted">Monitor capsule records. Private message contents and uploaded files are not exposed here.</p><div class="stats"><div class="stat"><span>TOTAL CAPSULES</span><strong><%=list==null?0:list.size()%></strong></div><div class="stat"><span>PLATFORM</span><strong>LIVE</strong></div><div class="stat"><span>ACCESS MODEL</span><strong>LOCKED</strong></div></div><div class="glass" style="padding:20px;overflow:auto"><table class="admin-table"><thead><tr><th>ID</th><th>CAPSULE</th><th>RECIPIENT</th><th>UNLOCKS</th><th>STATUS</th></tr></thead><tbody><%if(list!=null)for(Capsule c:list){%><tr><td>#<%=c.id%></td><td><%=Html.escape(c.title)%></td><td><%=Html.escape(c.recipientEmail==null?"Private":c.recipientEmail)%></td><td><%=c.unlockAt%></td><td><%=c.isUnlocked()?"Ready":"Locked"%></td></tr><%}%></tbody></table></div></main></body></html>